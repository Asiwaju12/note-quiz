# Copy to .env.local for local development. Never commit real values.

# ───────── Browser (exposed to the client — public values only) ─────────
# Supabase project settings. Use the PUBLISHABLE (anon) key, never a service-role/secret key.
# Leave these empty to run in Local mode (everything stored in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ───────── Server only (used by /api functions; never sent to the browser) ─────────
# Recall AI provider key (Anthropic Claude API). Without it, AI features show
# "not connected" and Study Centre generation falls back to Basic mode.
ANTHROPIC_API_KEY=

# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_CHAT_EFFORT=medium        # low | medium | high | xhigh | max
# AI_GENERATE_EFFORT=high
# AI_FALLBACKS=on              # server-side refusal fallbacks; set "off" to disable

# Require a valid Supabase session for /api/ai/* (turn ON before any public deployment).
# AI_REQUIRE_AUTH=false
# SUPABASE_URL=                # server-side copies, used to verify sessions when AI_REQUIRE_AUTH=true
# SUPABASE_PUBLISHABLE_KEY=
