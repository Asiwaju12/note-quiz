# Copy to .env.local for local development. Never commit real values.
# Browser-visible public Supabase configuration only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Google Gemini key. Never prefix with VITE_ or expose in browser code.
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash).
# AI_MODEL=gemini-2.5-flash
# AI_CHAT_EFFORT=medium
# AI_GENERATE_EFFORT=high

# Require a valid Supabase session for /api/ai/* before public deployment.
# AI_REQUIRE_AUTH=false
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
